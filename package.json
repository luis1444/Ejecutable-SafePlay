{
  "name": "safeplay",
  "version": "1.0.0",
  "description": "Aplicación de control parental SafePlay para monitoreo y gestión de tiempo de videojuegos.",
  "author": "Equipo SafePlay",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "build": "electron-builder"
  },
  "keywords": [
    "safeplay",
    "control parental",
    "electron",
    "desktop app",
    "videojuegos"
  ],
  "dependencies": {
    "electron-store": "^8.1.0",
    "express": "^5.1.0",
    "keytar": "^7.9.0",
    "node-fetch": "^3.3.2",
    "node-windows": "^1.0.0-beta.8",
    "ps-list": "^8.1.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.safeplay.desktop",
    "productName": "SafePlay",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!build/**/*",
      "!.git/**/*",
      "!*.md"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SafePlay",
      "uninstallDisplayName": "Desinstalar SafePlay",
      "artifactName": "SafePlay-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    }
  }
}